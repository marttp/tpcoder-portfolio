---
interface Props {
  chart: string;
  size?: 'small' | 'medium' | 'large';
}

const { chart, size = 'large' } = Astro.props;

const sizeClasses = {
  small: 'mermaid-small',
  medium: 'mermaid-medium',
  large: 'mermaid-large',
};
---

<div class={`mermaid-container ${sizeClasses[size]}`} data-mermaid-zoom>
  <div class="mermaid-toolbar">
    <button type="button" class="mermaid-open" aria-label="Open enlarged diagram" disabled>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M9 4H4v5m11-5h5v5m0 6v5h-5M9 20H4v-5" />
      </svg>
      <span>Expand</span>
    </button>
  </div>
  <div class="mermaid-wrapper">
    <pre class="mermaid">{chart}</pre>
  </div>

  <dialog class="mermaid-dialog" aria-label="Diagram zoom view">
    <div class="mermaid-dialog-shell">
      <div class="mermaid-dialog-toolbar">
        <div class="mermaid-zoom-controls" aria-label="Diagram zoom controls">
          <button type="button" data-zoom-out aria-label="Zoom out">−</button>
          <button type="button" data-zoom-reset aria-label="Reset diagram zoom">100%</button>
          <button type="button" data-zoom-in aria-label="Zoom in">+</button>
        </div>
        <button type="button" class="mermaid-close" aria-label="Close diagram zoom view">Close</button>
      </div>
      <div class="mermaid-viewport" tabindex="0" aria-label="Zoomed diagram. Scroll to view more.">
        <div class="mermaid-canvas"></div>
      </div>
    </div>
  </dialog>
</div>

<script>
  const initializeMermaidZoom = () => {
    document.querySelectorAll<HTMLElement>('[data-mermaid-zoom]').forEach((container) => {
      if (container.dataset.zoomReady === 'true') return;

      const openButton = container.querySelector<HTMLButtonElement>('.mermaid-open');
      const wrapper = container.querySelector<HTMLElement>('.mermaid-wrapper');
      const dialog = container.querySelector<HTMLDialogElement>('.mermaid-dialog');
      const viewport = container.querySelector<HTMLElement>('.mermaid-viewport');
      const canvas = container.querySelector<HTMLElement>('.mermaid-canvas');
      const closeButton = container.querySelector<HTMLButtonElement>('.mermaid-close');
      const zoomInButton = container.querySelector<HTMLButtonElement>('[data-zoom-in]');
      const zoomOutButton = container.querySelector<HTMLButtonElement>('[data-zoom-out]');
      const resetButton = container.querySelector<HTMLButtonElement>('[data-zoom-reset]');

      if (!openButton || !wrapper || !dialog || !viewport || !canvas || !closeButton || !zoomInButton || !zoomOutButton || !resetButton) return;

      container.dataset.zoomReady = 'true';

      let diagram: SVGSVGElement | null = null;
      let originalParent: ParentNode | null = null;
      let originalNextSibling: ChildNode | null = null;
      let originalStyle: string | null = null;
      let baseWidth = 0;
      let baseHeight = 0;
      let fitZoom = 1;
      let zoom = 1;

      const findDiagram = () => {
        diagram = wrapper.querySelector<SVGSVGElement>('svg');
        openButton.disabled = !diagram;
        return Boolean(diagram);
      };

      if (!findDiagram()) {
        const observer = new MutationObserver(() => {
          if (findDiagram()) observer.disconnect();
        });
        observer.observe(wrapper, { childList: true, subtree: true });
      }

      const updateZoom = (nextZoom: number) => {
        if (!diagram) return;

        zoom = Math.min(4, Math.max(Math.max(fitZoom * 0.5, 0.1), nextZoom));
        diagram.style.width = `${baseWidth * zoom}px`;
        diagram.style.height = `${baseHeight * zoom}px`;
        diagram.style.maxWidth = 'none';
        diagram.style.minHeight = '0';
        resetButton.textContent = `${Math.round(zoom * 100)}%`;
        zoomOutButton.disabled = zoom <= Math.max(fitZoom * 0.5, 0.1) + 0.001;
        zoomInButton.disabled = zoom >= 3.999;
      };

      const centerViewport = () => {
        viewport.scrollTo({
          left: Math.max((viewport.scrollWidth - viewport.clientWidth) / 2, 0),
          top: Math.max((viewport.scrollHeight - viewport.clientHeight) / 2, 0),
        });
      };

      const restoreDiagram = () => {
        if (!diagram || !originalParent) return;

        if (originalNextSibling && originalNextSibling.parentNode === originalParent) {
          originalParent.insertBefore(diagram, originalNextSibling);
        } else {
          originalParent.appendChild(diagram);
        }

        if (originalStyle === null) diagram.removeAttribute('style');
        else diagram.setAttribute('style', originalStyle);

        canvas.replaceChildren();
        diagram = null;
        originalParent = null;
        originalNextSibling = null;
        originalStyle = null;
        findDiagram();
      };

      openButton.addEventListener('click', () => {
        if (!findDiagram() || !diagram) return;

        const viewBox = diagram.viewBox?.baseVal;
        const diagramRect = diagram.getBoundingClientRect();
        baseWidth = viewBox?.width || diagramRect.width;
        baseHeight = viewBox?.height || diagramRect.height;
        originalParent = diagram.parentNode;
        originalNextSibling = diagram.nextSibling;
        originalStyle = diagram.getAttribute('style');
        canvas.appendChild(diagram);
        dialog.showModal();

        requestAnimationFrame(() => {
          const availableWidth = Math.max(viewport.clientWidth - 48, 1);
          const availableHeight = Math.max(viewport.clientHeight - 48, 1);
          fitZoom = Math.min(availableWidth / baseWidth, availableHeight / baseHeight, 1);
          updateZoom(fitZoom);
          requestAnimationFrame(centerViewport);
          viewport.focus({ preventScroll: true });
        });
      });

      closeButton.addEventListener('click', () => dialog.close());
      zoomInButton.addEventListener('click', () => updateZoom(zoom * 1.25));
      zoomOutButton.addEventListener('click', () => updateZoom(zoom / 1.25));
      resetButton.addEventListener('click', () => updateZoom(fitZoom));
      dialog.addEventListener('close', restoreDiagram);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeMermaidZoom, { once: true });
  } else {
    initializeMermaidZoom();
  }
</script>

<style>
  .mermaid-container {
    width: 100%;
    margin: 2rem 0;
    padding: 1.5rem;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow-x: auto;
  }

  .mermaid-toolbar {
    display: flex;
    justify-content: flex-end;
    margin: -0.5rem -0.5rem 0.25rem 0;
  }

  .mermaid-open,
  .mermaid-dialog button {
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #0f172a;
    font: inherit;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .mermaid-open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .mermaid-open > svg {
    width: 0.875rem !important;
    height: 0.875rem !important;
    min-width: 0 !important;
    min-height: 0 !important;
    max-width: none !important;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .mermaid-open:hover,
  .mermaid-dialog button:hover {
    border-color: #0a453e;
    color: #0a453e;
  }

  .mermaid-open:focus-visible,
  .mermaid-dialog button:focus-visible,
  .mermaid-viewport:focus-visible {
    outline: 2px solid #0edcaa;
    outline-offset: 2px;
  }

  .mermaid-open:disabled,
  .mermaid-dialog button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .mermaid-dialog {
    width: min(96vw, 1400px);
    height: min(92vh, 1000px);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    background: #f8fafc;
    color: #0f172a;
    box-shadow: 0 24px 80px rgb(15 23 42 / 0.35);
  }

  .mermaid-dialog::backdrop {
    background: rgb(15 23 42 / 0.72);
    backdrop-filter: blur(3px);
  }

  .mermaid-dialog-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
  }

  .mermaid-dialog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .mermaid-zoom-controls {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .mermaid-dialog button {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mermaid-dialog [data-zoom-reset] {
    min-width: 4.25rem;
  }

  .mermaid-viewport {
    overflow: auto;
    overscroll-behavior: contain;
    background-color: #f8fafc;
    background-image:
      linear-gradient(#e2e8f0 1px, transparent 1px),
      linear-gradient(90deg, #e2e8f0 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .mermaid-canvas {
    display: grid;
    place-items: center;
    min-width: 100%;
    min-height: 100%;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .mermaid-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    min-width: 0;
    overflow: auto;
  }

  .mermaid {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    background: transparent !important;
  }

  .mermaid-wrapper :global(svg) {
    display: block;
    width: 100% !important;
    max-width: 100%;
    height: auto !important;
    min-height: 0 !important;
    margin-inline: auto;
  }

  /* Size variants */
  .mermaid-small .mermaid {
    font-size: 12px;
  }

  .mermaid-small .mermaid-wrapper :global(svg) {
    max-height: 20rem;
  }

  .mermaid-medium .mermaid {
    font-size: 14px;
  }

  .mermaid-medium .mermaid-wrapper :global(svg) {
    max-height: 26rem;
  }

  .mermaid-large .mermaid {
    font-size: 16px;
  }

  .mermaid-large .mermaid-wrapper :global(svg) {
    max-height: 30rem;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .mermaid-container {
      padding: 1rem;
      margin: 1.5rem -1rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .mermaid-toolbar {
      margin-right: 0;
    }

    .mermaid-dialog {
      width: 100vw;
      height: 100dvh;
      border: 0;
      border-radius: 0;
    }

    .mermaid-dialog-toolbar {
      padding: 0.625rem 0.75rem;
    }

    .mermaid-canvas {
      padding: 1rem;
    }

    .mermaid-small .mermaid-wrapper :global(svg) {
      max-height: min(20rem, 60vh);
    }

    .mermaid-medium .mermaid-wrapper :global(svg) {
      max-height: min(26rem, 60vh);
    }

    .mermaid-large .mermaid-wrapper :global(svg) {
      max-height: min(30rem, 60vh);
    }
  }

  /* Mermaid node styling overrides */
  .mermaid-container :global(.node rect),
  .mermaid-container :global(.node polygon),
  .mermaid-container :global(.node circle) {
    stroke-width: 2px;
  }

  .mermaid-container :global(.edgeLabel) {
    font-size: 12px;
  }

  :global(.dark) .mermaid-open,
  :global(.dark) .mermaid-dialog button {
    border-color: #475569;
    background: #1e293b;
    color: #e2e8f0;
  }

  :global(.dark) .mermaid-open:hover,
  :global(.dark) .mermaid-dialog button:hover {
    border-color: #0edcaa;
    color: #0edcaa;
  }

  :global(.dark) .mermaid-dialog {
    border-color: #475569;
    background: #111827;
    color: #f8fafc;
  }

  :global(.dark) .mermaid-dialog-toolbar {
    border-color: #334155;
    background: #1e293b;
  }

  :global(.dark) .mermaid-viewport {
    background-color: #111827;
    background-image:
      linear-gradient(#1f2937 1px, transparent 1px),
      linear-gradient(90deg, #1f2937 1px, transparent 1px);
  }

  </style>
